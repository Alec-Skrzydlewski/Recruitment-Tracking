{
  "name": "recruitment-tracker",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle.mjs",
    "ci": "npm run lint && npm test && npm run build && npm run build:demo && npm run check:bundle"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "private": true
}
